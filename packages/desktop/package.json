{
  "name": "palsentrydesktop",
  "productName": "PalSentry",
  "desktopName": "palsentry.desktop",
  "version": "1.2.4",
  "private": true,
  "description": "PalSentry desktop app for macOS, Windows and Linux",
  "author": "PalSentry <wisdomsky@users.noreply.github.com>",
  "homepage": "https://github.com/wisdomsky/palsentry",
  "type": "module",
  "main": "dist/main.js",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "electron .",
    "build": "tsup && node scripts/stage.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && electron-builder --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
