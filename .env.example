# Optional configuration file for Docker Compose.
#
# Compose reads this file automatically when it is named `.env` in this directory, and it is only
# used for ${VARIABLE} interpolation in docker-compose.yml. Exported shell variables and values
# supplied by your container manager take precedence over it, so this file is not required:
#
#   cp .env.example .env
#
# Every value below becomes a container environment variable and stays readable by anyone who can
# inspect the container. Replace the required Palworld values and single-quote custom secrets so
# that `$` and `#` characters survive; details:
# https://docs.docker.com/compose/how-tos/environment-variables/

# REQUIRED: your existing Palworld server, with RESTAPIEnabled=True.
PALWORLD_REST_URL=http://127.0.0.1:8212
PALWORLD_ADMIN_PASSWORD=''

# Dashboard credentials. The default login is admin/admin; change it for exposed deployments.
PALSENTRY_LOGIN_USERNAME=admin
# Set this plaintext password, or set PALSENTRY_LOGIN_PASSWORD_HASH instead.
PALSENTRY_LOGIN_PASSWORD='admin'
# Run `npm run hash-password` (or the documented docker run command) and paste the result
# SINGLE-QUOTED. The hash wins if both password variables are set.
# PALSENTRY_LOGIN_PASSWORD_HASH='scrypt$<saltHex>$<hashHex>'

# Shared default cookie-signing secret. Replace it with `openssl rand -hex 32` for exposed
# deployments. Keep it stable across restarts; rotate it to revoke every existing session.
PALSENTRY_SESSION_SECRET='bb5930c05402c03f897c0cdd0e98bb8420a8359f7dbab25fe53df1a5c060d5ea'
PALSENTRY_SESSION_TTL_HOURS=12

# Independent safety gate: kick, ban, unban, shutdown, stop, and restart are enabled by default.
# Set this to false to disable them. Enabled destructive actions still require UI confirmation.
PALSENTRY_ALLOW_DESTRUCTIVE=true


# Container image used by the default Compose service. It pulls the published multi-platform image;
# switch to the Docker Hub copy or pin a released version, for example:
# PALSENTRY_IMAGE=docker.io/wisdomsky/palsentry:latest
# PALSENTRY_IMAGE=ghcr.io/wisdomsky/palsentry:1.2.3
# To build from this checkout instead, use docker-compose.build.yml as documented in the README.
# PALSENTRY_IMAGE=ghcr.io/wisdomsky/palsentry:latest

# Enable ONLY behind a trusted HTTPS reverse proxy. Sets Secure cookies and trusts forwarded
# client IP headers. Block direct access to the container so clients cannot spoof those headers.
# Leave false for direct http:// access; otherwise browsers will not send the session cookie.
PALSENTRY_TRUST_PROXY=false

# Upstream REST client
PALSERVER_REST_USERNAME=admin
PALSERVER_TIMEOUT_MS=10000

# SQLite history: seconds between metric samples, and days retained.
# The interval below covers performance metrics only. Player position recording has its own
# cadence, chosen from the Players tab and stored in the database (60 seconds by default).
PALSENTRY_SAMPLE_INTERVAL_SECONDS=60
# Retention applies to metric samples and to recorded player movement.
PALSENTRY_HISTORY_RETENTION_DAYS=30

# Restart requires the GAME SERVER'S container to use restart: unless-stopped.
# PalSentry has no Docker socket and cannot start a stopped server itself.
PALSENTRY_RESTART_WAIT_SECONDS=30
PALSENTRY_RESTART_HEALTH_TIMEOUT_SECONDS=180
PALSENTRY_RESTART_POLL_INTERVAL_MS=2000

# Map: Palpagos and World Tree textures are bundled so both regions work offline.
# Palworld and its artwork are owned by Pocketpair; see packages/web/public/maps/README.md.
# To use your own legally obtained images instead, mount ./map in compose and set either URL:
# PALSENTRY_MAP_TEXTURE_URL=/map/t_worldmap.png
# PALSENTRY_WORLD_TREE_TEXTURE_URL=/map/t_treemap.png
# Projection: none | new (default, community Palworld 1.0+ calibration) | legacy
# Set it to "none" to turn both textures off and use interactive coordinate grids.
# These calibrations can drift with game updates; verify pin placement yourself.
PALSENTRY_MAP_PROJECTION=new

LOG_LEVEL=info

# Advanced, non-Docker paths/listener. Compose pins host, port and data dir inside the image, and
# the published image only reads /data. Local npm dev/start use ./data/palsentry.db by default.
# PALSENTRY_HOST=127.0.0.1
# PALSENTRY_PORT=3000
# PALSENTRY_DATA_DIR=./data
# PALSENTRY_DB_PATH=./data/palsentry.db
# PALSENTRY_WEB_DIST=./packages/web/dist
